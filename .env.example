# Copy to .env and fill in real values
# Database. Locally: start it with `npm run db:local` and use these values.
# On Vercel: DATABASE_URL = pooled connection string from Neon/Supabase, DIRECT_URL = direct one
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coolphotos"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/coolphotos"
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The public URL of the site (e.g. https://coolphotos.example.com)
NEXTAUTH_URL="http://localhost:3000"
# Shop PromptPay: phone number (0812345678) or 13-digit national/tax ID
PROMPTPAY_ID=""
# Name customers see in their banking app, so they can check before paying
PROMPTPAY_NAME=""
