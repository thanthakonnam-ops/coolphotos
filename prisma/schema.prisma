generator client {
  provider = "prisma-client-js"
}

// Locally: run `npm run db:local` (see .env.example).
// On Vercel: DATABASE_URL is the pooled connection string from Neon/Supabase and
// DIRECT_URL the direct (non-pooled) one, used only for running migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?  @default("")
  role      String   @default("USER")
  createdAt DateTime @default(now())
  bookings  Booking[]
  cartItems CartItem[]
}

model Gear {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?  @default("")
  pricePerDay Int
  image       String
  status      String   @default("AVAILABLE")
  queueDate   String?  @default("")
  createdAt   DateTime @default(now())
}

model Photographer {
  id           String   @id @default(cuid())
  name         String
  specialty    String
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  pricePerHalf Int
  avatar       String
  image1       String
  image2       String
  image3       String
  bio          String?  @default("")
  createdAt    DateTime @default(now())
}

model Package {
  id          String  @id @default(cuid())
  name        String
  description String
  price       Int
  includes    String
  featured    Boolean @default(false)
  createdAt   DateTime @default(now())
}

model Booking {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderRef   String?  // shared by all bookings made in one checkout; customers quote it when paying
  itemType   String
  itemId     String?
  itemName   String
  quantity   Int      @default(1)
  startDate  String
  endDate    String?
  status     String   @default("PENDING")
  totalPrice Int
  deposit    Int      @default(0)
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  address       String?
  notes         String?
  paymentMethod String?
  createdAt  DateTime @default(now())
}

model CartItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  itemType String
  itemId   String
  itemName String
  price    Int
  image    String?  @default("")
  category String?  @default("")
  quantity Int      @default(1)
  addedAt  DateTime @default(now())
}
